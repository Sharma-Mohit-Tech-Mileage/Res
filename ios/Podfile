target 'My Sparklight' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  # Flags change depending on the env values.
  #flags = get_default_flags()
    pod 'Firebase', '11.15.0', :modular_headers => true
    pod 'FirebaseCoreInternal', '11.15.0', :modular_headers => true
    pod 'GoogleUtilities', '8.1.4', :modular_headers => true
    pod 'FirebaseCore', '11.15.0', :modular_headers => true
    
    pod 'ZendeskSDKMessaging', '2.39.0'
    
 use_react_native!(
  :path => config[:reactNativePath],
  :new_arch_enabled => false,
  :app_path => "#{Pod::Config.instance.installation_root}/.."
)

  target 'My SparklightTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    #__apply_Xcode_12_5_M1_post_install_workaround(installer)
    # Xcode 27 refuses deployment targets below 15.0, and several pods still declare 9.0-13.4.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1' if bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
      end
    end
    # fmt 11's consteval path does not compile under Apple Clang (Xcode 16+); force it off, idempotently.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base) && !File.read(fmt_base).include?('FMT_APPLE_CONSTEVAL_WORKAROUND')
      guard = "#if !defined(__cpp_lib_is_constant_evaluated)\n#  define FMT_USE_CONSTEVAL 0\n"
      src = File.read(fmt_base)
      if src.include?(guard)
        File.chmod(0644, fmt_base)
        File.write(fmt_base, src.sub(guard, "// FMT_APPLE_CONSTEVAL_WORKAROUND\n#if defined(__APPLE__)\n#  define FMT_USE_CONSTEVAL 0\n#elif !defined(__cpp_lib_is_constant_evaluated)\n#  define FMT_USE_CONSTEVAL 0\n"))
      else
        Pod::UI.warn 'fmt/base.h changed upstream; the Apple consteval workaround was not applied.'
      end
    end
  end
end
